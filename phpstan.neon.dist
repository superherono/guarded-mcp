includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 5
	paths:
		- guarded-mcp.php
		- uninstall.php
		- includes
	scanFiles:
		# Plugin constants (define() at load time).
		- guarded-mcp.php
		# Polylang, Yoast SEO and the MCP Adapter classes the plugin references.
		- tests/phpstan-stubs.php
